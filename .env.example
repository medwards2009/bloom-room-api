# Server
PORT=8080

# Database (matches docker-compose.yaml)
DB_HOST=localhost
DB_PORT=5432
DB_USER=bloom
DB_PASSWORD=secret
DB_NAME=bloom_room_dev

# Auth — API-issued JWT
# AUTH_DEV_MODE=true relaxes auth for local work: weak JWT_SECRET allowed and
# GOOGLE_CLIENT_IDS optional. Must be false/unset in real environments.
AUTH_DEV_MODE=true
JWT_SECRET=            # >=8 chars in dev mode, >=32 chars otherwise
JWT_EXPIRES_IN=7d

# Google Sign-In: comma-separated list of allowed OAuth client IDs (mobile/web).
# Required unless AUTH_DEV_MODE=true. Must include GOOGLE_WEB_CLIENT_ID.
GOOGLE_CLIENT_IDS=

# Web auth-code flow: the web app's OAuth client id + secret, used server-side to
# exchange the authorization code for tokens. Secret lives ONLY on the API, never
# in the web app. Required unless AUTH_DEV_MODE=true.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CORS: comma-separated allow-list of browser origins, each WITH scheme (and port
# if non-default), e.g. http://localhost:5173,https://bloomroom.michaelswebstuff.com
# Optional. When AUTH_DEV_MODE=true and this is unset, any origin is reflected;
# setting it (even in dev) switches to the strict allow-list. A real environment
# serving a browser client must set it, or cross-origin requests are refused.
CORS_ORIGINS=
